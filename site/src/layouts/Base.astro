---
import "../styles/global.css";
import Header from "../components/Header.astro";
import type { Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
const path = Astro.url.pathname;
const basePath = path.startsWith("/ja/") ? path.slice(3) : path === "/ja" ? "/" : path;
const enUrl = new URL(basePath, Astro.site);
const jaUrl = new URL(basePath === "/" ? "/ja/" : `/ja${basePath}`, Astro.site);
const canonicalUrl = new URL(path, Astro.site);
const companyUrl = "https://joinclass.co.jp/?utm_source=axiom-ui";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Axiom UI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-white text-zinc-900 antialiased">
    <Header lang={lang} />
    <slot />
    <footer class="border-t border-zinc-200 py-8 text-center text-sm text-zinc-500">
      <p>
        MIT License — <a href="https://github.com/JOINCLASS/axiom-ui" class="underline hover:text-zinc-900">JOINCLASS/axiom-ui</a>
      </p>
      <p class="mt-2">
        {lang === "ja" ? (
          <>
            開発・提供: <a href={companyUrl} class="underline hover:text-zinc-900">合同会社ジョインクラス</a>
            （React・AI を使った業務システム開発のご相談は<a href={`${companyUrl}#form`} class="underline hover:text-zinc-900">こちら</a>）
          </>
        ) : (
          <>Built by <a href={companyUrl} class="underline hover:text-zinc-900">JOINCLASS LLC</a></>
        )}
      </p>
    </footer>
  </body>
</html>
