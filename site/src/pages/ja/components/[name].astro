---
import Docs from "../../../layouts/Docs.astro";
import ComponentDoc from "../../../components/ComponentDoc.astro";
import { componentNames, manifests, displayName } from "../../../lib/data";

export function getStaticPaths() {
  return componentNames.map((name) => ({ params: { name } }));
}

const { name } = Astro.params;
---

<Docs
  lang="ja"
  title={`${displayName(name)} — Axiom UI`}
  description={manifests[name]!.intent}
>
  <ComponentDoc lang="ja" name={name} />
</Docs>
