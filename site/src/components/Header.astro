---
import { localePath, t, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const path = Astro.url.pathname;
const basePath = path.startsWith("/ja/") ? path.slice(3) : path === "/ja" ? "/" : path;

const nav = [
  { href: localePath(lang, "/docs/"), label: t(lang, "Docs", "ドキュメント") },
  { href: localePath(lang, "/components/"), label: t(lang, "Components", "コンポーネント") },
];
---

<header class="sticky top-0 z-40 border-b border-zinc-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4">
    <a href={localePath(lang, "/")} class="font-bold tracking-tight">Axiom UI</a>
    <nav class="flex gap-4 text-sm text-zinc-600">
      {nav.map((item) => (
        <a href={item.href} class="hover:text-zinc-900">{item.label}</a>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-3 text-sm">
      <a href={basePath} class={lang === "en" ? "font-semibold" : "text-zinc-500 hover:text-zinc-900"}>EN</a>
      <span class="text-zinc-300">/</span>
      <a href={basePath === "/" ? "/ja/" : `/ja${basePath}`} class={lang === "ja" ? "font-semibold" : "text-zinc-500 hover:text-zinc-900"}>JA</a>
      <a href="https://github.com/JOINCLASS/axiom-ui" class="ml-2 text-zinc-500 hover:text-zinc-900" aria-label="GitHub">
        <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
        </svg>
      </a>
    </div>
  </div>
</header>
